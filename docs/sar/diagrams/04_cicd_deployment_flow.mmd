flowchart TD
    classDef dev   fill:#1e3a5f,stroke:#0d2247,color:#ffffff,font-weight:bold
    classDef gate  fill:#5c1a3a,stroke:#3a0d22,color:#fce7f3,font-weight:bold
    classDef ci    fill:#3b1f6e,stroke:#2a1050,color:#ede9fe,font-weight:bold
    classDef stage fill:#3a2a10,stroke:#221808,color:#fef3c7,font-weight:bold
    classDef ok    fill:#1a3a2a,stroke:#0d2218,color:#e6f4ea,font-weight:bold
    classDef fail  fill:#3a1010,stroke:#220808,color:#fee2e2,font-weight:bold

    DEV["Developer\nPushes feature branch to GitLab\nor opens Merge Request"]:::dev

    REVIEW{"Peer Code Review\nGitLab Merge Request\nMinimum 1 approval required\nBranch protection — no direct push to main"}:::gate

    REJECT["MR Rejected\nRevisions required\nDeveloper notified"]:::fail

    RUNNER["GitLab Runner\ntag: gitlab-runner-kubernetes\nBase image: eclipse-temurin:21-jdk\nMaven cache: .m2/repository"]:::ci

    BUILD["Stage 1 — Build\nCommand: ./mvnw clean compile\nArtifact: target/ retained 1 hour"]:::ci

    BUILD_GATE{"Build\nSucceeded?"}:::gate

    TEST["Stage 2 — Test\nCommand: ./mvnw test\nJUnit XML report published to GitLab\nJaCoCo coverage report retained 1 week"]:::ci

    TEST_GATE{"All Tests\nPassed?"}:::gate

    FAIL_BUILD["Pipeline FAILED — Build Stage\nDeveloper notified via GitLab"]:::fail
    FAIL_TEST["Pipeline FAILED — Test Stage\nJUnit report available in GitLab UI"]:::fail

    ADMIN["Authorized Administrator\nManual deployment decision\nfollowing successful pipeline run"]:::dev

    DOCKER_BUILD["STAGE Server\ndocker compose build\nBase image: eclipse-temurin:21-jre\nApp JAR packaged into image"]:::stage

    DOCKER_UP["docker compose up -d\napp  — host port 8081 exposed\ndb   — port 5432 internal only\nVolumes: qtracker_pgdata, qtracker_uploads"]:::stage

    FLYWAY["Flyway Migration\nExecutes automatically on app startup\nApplies all pending DB schema migrations"]:::stage

    HEALTH{"Health Verification\nGET /actuator/health\nExpected: HTTP 200 status UP"}:::gate

    FAIL_HEALTH["Deployment FAILED\nInspect logs:\ndocker compose logs app\nRollback if required"]:::fail

    OK["Deployment Successful\nSTAGE environment is live\nPost-deployment verification complete"]:::ok

    DEV          --> REVIEW
    REVIEW       -- "Approved" --> RUNNER
    REVIEW       -- "Changes requested" --> REJECT
    REJECT       --> DEV
    RUNNER       --> BUILD
    BUILD        --> BUILD_GATE
    BUILD_GATE   -- "Yes" --> TEST
    BUILD_GATE   -- "No"  --> FAIL_BUILD
    TEST         --> TEST_GATE
    TEST_GATE    -- "Yes" --> ADMIN
    TEST_GATE    -- "No"  --> FAIL_TEST
    ADMIN        --> DOCKER_BUILD
    DOCKER_BUILD --> DOCKER_UP
    DOCKER_UP    --> FLYWAY
    FLYWAY       --> HEALTH
    HEALTH       -- "UP"      --> OK
    HEALTH       -- "Not UP"  --> FAIL_HEALTH
