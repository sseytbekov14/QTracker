flowchart LR
    classDef actor  fill:#1e3a5f,stroke:#0d2247,color:#ffffff,font-weight:bold
    classDef filter fill:#3b1f6e,stroke:#2a1050,color:#ede9fe,font-weight:bold
    classDef ctrl   fill:#1a3a2a,stroke:#0d2218,color:#e6f4ea,font-weight:bold
    classDef authz  fill:#5c1a3a,stroke:#3a0d22,color:#fce7f3,font-weight:bold
    classDef svc    fill:#1e3a5f,stroke:#0d2247,color:#e0ecff
    classDef store  fill:#3a2a10,stroke:#221808,color:#fef3c7

    BROWSER["Browser\nAuthenticated User"]:::actor

    subgraph FILTERS["Spring Security — Filter Chain"]
        direction TB
        F1["CorrelationIdFilter\nGenerates UUID correlationId\nInjects MDC + X-Correlation-Id header"]:::filter
        F2["RateLimitingFilter\nSliding window limits\n20 req/min login\n20 req/min attachments\n120 req/min API"]:::filter
        F3["UserEnabledGuardFilter\nRe-reads users.enabled from DB\non every authenticated request\nReal-time account revocation"]:::filter
    end

    subgraph CONTROLLERS["Controller Layer"]
        direction TB
        C1["AuthController\nPOST /login  GET /logout"]:::ctrl
        C2["ControlController\n/api/controls/**"]:::ctrl
        C3["WorkflowController\n/api/workflow/**"]:::ctrl
        C4["FileAttachmentController\n/api/attachments/**"]:::ctrl
        C5["UserController\n/api/users/**  /api/admin/**"]:::ctrl
    end

    subgraph SERVICES["Service and Authorization Layer"]
        direction TB
        A1["AuthorizationPolicy\n+ ControlPermissionService\nRole-based access check\nField-level read/write isolation"]:::authz
        S1["WorkflowServiceImpl\nState machine transitions\nworkflow_history persistence"]:::svc
        S2["FileStorageService\nFilename and folder sanitization\nPath traversal prevention"]:::svc
        S3["AdminAuditService\nField-level before/after diff\nadmin_audit_log persistence"]:::svc
    end

    subgraph PERSISTENCE["Persistence Layer"]
        DB[("PostgreSQL 17\ncontrols, users\nworkflow_history\nadmin_audit_log")]:::store
        VOL["Docker Volume\n/app/uploads\nqtracker_uploads"]:::store
    end

    BROWSER --> F1 --> F2 --> F3 --> CONTROLLERS
    CONTROLLERS --> A1 --> DB
    C2 --> S3 --> DB
    C3 --> S1 --> DB
    C4 --> S2 --> VOL
    C5 --> S3
