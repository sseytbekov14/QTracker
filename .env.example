# Docker / production profile
SPRING_PROFILES_ACTIVE=prod

# Host port (application only; database is internal-only)
APP_PORT=8081

# PostgreSQL container settings
POSTGRES_DB=QTracker
POSTGRES_USER=qtracker_app
POSTGRES_PASSWORD=SET_SECURE_PASSWORD_IN_REAL_ENV

# Spring datasource settings
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/QTracker
SPRING_DATASOURCE_USERNAME=qtracker_app
SPRING_DATASOURCE_PASSWORD=SET_SECURE_PASSWORD_IN_REAL_ENV

# App runtime settings
APP_BASE_URL=http://localhost:8081
FILE_UPLOAD_DIR=/app/uploads

# Email notifications (disabled by default)
NOTIFICATIONS_EMAIL_ENABLED=false
NOTIFICATIONS_EMAIL_WHITELIST_ENFORCED=false
NOTIFICATIONS_EMAIL_WHITELIST=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
