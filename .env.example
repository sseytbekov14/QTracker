# Docker / production profile
SPRING_PROFILES_ACTIVE=<dev|stage|prod>

# Host port (application only; database is internal-only)
APP_PORT=<443_or_8080>

# PostgreSQL container settings
POSTGRES_DB=QTracker
POSTGRES_USER=<db_user>
POSTGRES_PASSWORD=<db_password>

# Spring datasource settings
SPRING_DATASOURCE_URL=jdbc:postgresql://<db-host>:5432/QTracker
SPRING_DATASOURCE_USERNAME=<db_user>
SPRING_DATASOURCE_PASSWORD=<db_password>

# App runtime settings
APP_BASE_URL=https://<app-hostname>
# Requests on any other host name (e.g. https://kzqtracker/) get 301 to this one; empty: no redirect
APP_CANONICAL_HOST=kzqtracker.go1.kworld.kpmg.com
FILE_UPLOAD_DIR=/app/uploads

# Planned notifications (occurrence day, reminders day 3 and 6, deadline, overdue), every 5 minutes on working days
# from 09:30 Asia/Almaty; false: none of them (the notifications of the workflow steps still go)
NOTIFICATIONS_SCHEDULER_ENABLED=true
# Email notifications (disabled by default): false records every e-mail as SKIPPED_DISABLED in email_outbox, the
# in-app notifications are made as usual; e-mails held back while false are not sent after switching to true
NOTIFICATIONS_EMAIL_ENABLED=false
# smtp (SPRING_MAIL_*) or log (the whole e-mail in the application log, nothing sent)
NOTIFICATIONS_EMAIL_PROVIDER=smtp
# The From address of the e-mails (the service mailbox); with e-mail on and this empty the start logs a WARN and the
# e-mails go without a From address, which the SMTP relay may refuse
NOTIFICATIONS_EMAIL_FROM=<service-mailbox@company.com>
# true: e-mails only to the addresses of NOTIFICATIONS_EMAIL_WHITELIST (comma-separated, any case), the others are
# recorded SKIPPED_DISABLED "not in the whitelist"; true with an empty list sends to nobody (a warning at start);
# false: everybody, the list is not read
NOTIFICATIONS_EMAIL_WHITELIST_ENFORCED=false
NOTIFICATIONS_EMAIL_WHITELIST=
# SMTP relay settings (STARTTLS is always required)
SPRING_MAIL_HOST=<smtp-host>
SPRING_MAIL_PORT=25
# true: the relay needs a sign-in (Proofpoint Secure Email Relay: SPRING_MAIL_USERNAME is the Relay User ID);
# false (default): a relay without a sign-in, SPRING_MAIL_USERNAME and SPRING_MAIL_PASSWORD are not used
SPRING_MAIL_SMTP_AUTH=false
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
