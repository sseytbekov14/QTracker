<?xml version="1.0" encoding="UTF-8"?>
<!--
  A made-up identity provider for the tests only (SamlTestSupport signs its answers with test-idp.key).
  It stands where the federation metadata of the Microsoft Entra application is in a deployment (SAML_METADATA_URI).
-->
<md:EntityDescriptor xmlns:md="urn:oasis:names:tc:SAML:2.0:metadata"
                     xmlns:ds="http://www.w3.org/2000/09/xmldsig#"
                     entityID="https://idp.qtracker.test/tests-only">
    <md:IDPSSODescriptor protocolSupportEnumeration="urn:oasis:names:tc:SAML:2.0:protocol">
        <md:KeyDescriptor use="signing">
            <ds:KeyInfo>
                <ds:X509Data>
                    <ds:X509Certificate></ds:X509Certificate>
                </ds:X509Data>
            </ds:KeyInfo>
        </md:KeyDescriptor>
        <md:NameIDFormat>urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress</md:NameIDFormat>
        <md:SingleSignOnService Binding="urn:oasis:names:tc:SAML:2.0:bindings:HTTP-Redirect"
                                Location="https://idp.qtracker.test/tests-only/saml2"/>
    </md:IDPSSODescriptor>
</md:EntityDescriptor>
